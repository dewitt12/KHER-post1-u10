{
  "info": {
    "name": "API Catálogo de Productos",
    "description": "Pruebas de extremo a extremo (caja negra, HTTP real) del catálogo de productos. Ejecutar con la aplicación en marcha: mvn spring-boot:run",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "productoId", "value": "" }
  ],
  "item": [
    {
      "name": "1. POST crear producto",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Teclado mecánico\",\n  \"precio\": 120.0,\n  \"categoria\": \"ELECTRONICA\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/productos",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201 Created\", () => {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Respuesta contiene id numérico\", () => {",
              "    const b = pm.response.json();",
              "    pm.expect(b).to.have.property(\"id\");",
              "    pm.collectionVariables.set(\"productoId\", b.id);",
              "});",
              "pm.test(\"Tiempo de respuesta < 500ms\", () => {",
              "    pm.expect(pm.response.responseTime).to.be.below(500);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. GET obtener producto por id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productos/{{productoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos", "{{productoId}}"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 OK\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"El nombre coincide con el creado\", () => {",
              "    pm.expect(pm.response.json().nombre).to.eql(\"Teclado mecánico\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3. GET listar por categoría",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productos?categoria=ELECTRONICA",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos"],
          "query": [{ "key": "categoria", "value": "ELECTRONICA" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 OK\", () => {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"La lista contiene el producto creado\", () => {",
              "    const lista = pm.response.json();",
              "    pm.expect(lista).to.be.an(\"array\").that.is.not.empty;",
              "    pm.expect(lista.map(p => p.nombre)).to.include(\"Teclado mecánico\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. GET producto inexistente (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/productos/99999",
          "host": ["{{baseUrl}}"],
          "path": ["api", "productos", "99999"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 404 Not Found\", () => {",
              "    pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
